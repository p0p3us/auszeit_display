/* ==========================================================
   Namenstag-Folie – spezifisches Layout
   ========================================================== */

.namenstag-card {
  width: 54vw;
  max-width: 920px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-top: 46px;
}

.namenstag-kicker {
  margin: 0 0 18px 0;
  font-size: 56px;
  line-height: 1.1;
  font-weight: 300;
  letter-spacing: 0.018em;
  color: rgba(243, 234, 216, 0.90);
  text-shadow: 0 4px 12px rgba(0, 0, 0, 0.32);
}

.namenstag-card h1 {
  margin: 0;
  font-family: var(--auszeit-font-serif);
  font-size: 138px;
  line-height: 0.96;
  font-weight: 600;
  letter-spacing: 0.035em;
  color: var(--auszeit-gold);
  text-shadow:
    0 3px 8px rgba(0, 0, 0, 0.40),
    0 0 26px rgba(214, 179, 106, 0.10);
}

.namenstag-card h1::after {
  content: "";
  display: block;
  width: 360px;
  height: 1px;
  margin: 34px 0 24px 0;
  background: linear-gradient(90deg, rgba(214, 179, 106, 0.86), rgba(214, 179, 106, 0));
}

.namenstag-date {
  margin: 0 0 48px 0;
  font-size: 42px;
  line-height: 1.15;
  font-weight: 300;
  letter-spacing: 0.018em;
  color: rgba(243, 234, 216, 0.84);
  text-shadow: 0 3px 10px rgba(0, 0, 0, 0.28);
}

.namenstag-subtitle {
  font-size: 30px;
  color: rgba(243, 234, 216, 0.68);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-top: 42px;
  margin-bottom: 12px;
}

.namenstag-names {
  display: flex;
  flex-wrap: wrap;
  gap: 22px;
  align-items: baseline;
}

.namenstag-name {
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: 54px;
  font-weight: 600;
  line-height: 1;
  color: #f3ead8;
  background: none;
  border: none;
  box-shadow: none;
  padding: 0;
  border-radius: 0;
  letter-spacing: 0.025em;
}

.namenstag-name:not(:last-child)::after {
  content: "·";
  margin-left: 22px;
  color: rgba(214, 179, 106, 0.75);
}

.namenstag-name.muted {
  opacity: 0.70;
  font-size: 34px;
  border-color: rgba(214, 179, 106, 0.34);
}

.namenstag-image {
  width: 56vw;
  max-width: 1040px;
}
