/* ==========================================================
   Café Auszeit – Basisdesign für alle Display-Folien
   Ziel: klassisch, ruhig, nobel, kaffehausartig
   ========================================================== */

:root {
  --auszeit-wine-deep: #1a0004;
  --auszeit-wine-dark: #260208;
  --auszeit-wine: #5b0712;

  --auszeit-gold: #d6b36a;
  --auszeit-gold-muted: #a9823d;
  --auszeit-gold-soft: rgba(214, 179, 106, 0.62);

  --auszeit-ivory: #f3ead8;
  --auszeit-ivory-muted: rgba(243, 234, 216, 0.78);

  --auszeit-shadow: rgba(0, 0, 0, 0.48);

  --auszeit-font-text: "Source Sans 3", "Segoe UI", Arial, Helvetica, sans-serif;
  --auszeit-font-serif: "Cormorant Garamond", "Playfair Display", Georgia, "Times New Roman", serif;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
}

body {
  overflow: hidden;
  font-family: var(--auszeit-font-text);
  color: var(--auszeit-ivory);
  background: var(--auszeit-wine-deep);
  -webkit-font-smoothing: antialiased;
  text-rendering: geometricPrecision;
}

/* Hintergrundbild bleibt die gemeinsame Basis aller Folien. */
.display-background {
  position: fixed;
  inset: 0;
  background-image: url("/resources/images/hintergrund.png");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  z-index: 0;
}

/* Ruhiger Licht-/Schattenfilm über dem Hintergrund.
   Macht die Struktur edler und nimmt ihr optisch Härte. */
.display-background::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 30% 36%, rgba(255, 235, 195, 0.075), transparent 34%),
    linear-gradient(90deg, rgba(18, 0, 5, 0.22), rgba(18, 0, 5, 0.42) 58%, rgba(18, 0, 5, 0.70));
  pointer-events: none;
}

/* Dezente Vignette für mehr Tiefe. */
.display-background::after {
  content: "";
  position: absolute;
  inset: 0;
  box-shadow: inset 0 0 180px rgba(0, 0, 0, 0.58);
  pointer-events: none;
}

.display-logo {
  position: fixed;
  top: 42px;
  right: 70px;
  width: 345px;
  height: auto;
  z-index: 10;
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.42));
}

.display-topic-image {
  position: fixed;
  right: -20px;
  bottom: -10px;
  width: 620px;
  max-width: 620px;
  height: auto;
  z-index: 2;
  pointer-events: none;
  opacity: 0.82;
  filter: saturate(0.88) contrast(0.92) brightness(0.92);
  mask-image: radial-gradient(
    circle at 82% 82%,
    black 0%,
    black 38%,
    rgba(0, 0, 0, 0.65) 48%,
    transparent 72%
  );
  -webkit-mask-image: radial-gradient(
  circle at 82% 82%,
  black 0%,
  black 38%,
  rgba(0, 0, 0, 0.65) 48%,
  transparent 72%
  );
}

.namenstag-card::after {
  content: "";
  display: block;
  width: 520px;
  height: 1px;
  margin-top: 42px;
  background: linear-gradient(
    90deg,
    rgba(214, 179, 106, 0.5),
    rgba(214, 179, 106, 0)
  );
}

.display-content {
  position: relative;
  z-index: 5;
  width: 100vw;
  height: 100vh;
  padding: 120px 150px 110px 150px;
}

.display-footer {
  position: fixed;
  left: 150px;
  right: 150px;
  bottom: 50px;
  display: flex;
  justify-content: space-between;
  font-size: 22px;
  line-height: 1.2;
  color: var(--auszeit-ivory-muted);
  opacity: 0.65;
  z-index: 6;
}
